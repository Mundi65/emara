# Copia este archivo como ".env.local" y pon los valores de tu proyecto Supabase.
# Están en Supabase → Project Settings → API. Son públicos (van al navegador).
# NUNCA pongas aquí la service_role key ni la API key de Anthropic.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-o-publishable-key
